# Keep the multi-GB weights, sample audio and local envs out of the build
# context — weights are mounted at runtime, not baked into the image.
*.safetensors
*.wav
*.mp3
!web/public/headache_by_lost_deposit_1min.mp3
*.ogg
*.mid
.venv
web/node_modules
# Built fresh in the web-builder stage; a stale local build must not leak
# into the runtime image via `COPY muscriptor/`.
muscriptor/web_dist
.git
.gitignore
__pycache__
*.pyc
.pytest_cache
.ruff_cache
test.ipynb
Dockerfile
.dockerignore

# Cog (cog.yaml, predict.py) bakes the float16 weights into its image; run
# scripts/convert_weights_fp16.py before `cog push`. *.safetensors above only
# matches the repo root. The float32 original stays out: every cold start
# pulls the whole image.
weights/model.safetensors
# cog runs pyenv inside the image (python 3.12); the 3.13 pin in
# .python-version breaks its final pip freeze.
.python-version
